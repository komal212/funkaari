# Instagram Graph API (optional)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=
INSTAGRAM_HASHTAGS=bangalorekids,bangaloretoddlers,kidsinbangalore,bangalorepreschool,toddlerbangalore

# Apify (optional — easier live feed, no Meta app review)
# Console → Settings → Integrations → API token
# https://console.apify.com/settings/integrations
# MCP: https://mcp.apify.com/?tools=actors,docs,apify/instagram-scraper
APIFY_TOKEN=
APIFY_ACTOR_ID=apify~instagram-scraper
APIFY_RESULTS_LIMIT=20
# Optional: only posts newer than this (instagram-scraper)
APIFY_NEWER_THAN=14 days
# Optional: extra profile URLs (comma-separated)
# APIFY_PROFILE_URLS=https://www.instagram.com/funkaari.in/
# Optional: override all URLs (hashtag + profile). If set, hashtags are ignored.
# APIFY_DIRECT_URLS=https://www.instagram.com/explore/tags/bangalorekids/

# Bright Data Instagram Scraper API (optional — watchlist of preschool profiles)
# https://brightdata.com → User settings → API key
# Docs: https://docs.brightdata.com/datasets/scrapers/instagram/quickstart
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_PROFILE_URLS=https://www.instagram.com/eurokids_official/,https://www.instagram.com/kidzeeofficial/
# Delhi NCR listings (Google Sheet CSV export)
# https://docs.google.com/spreadsheets/d/1jsyvxM-Ux8zQAyCgboDTwbFFT4tiufUFC4aNtYn2_n0/edit?gid=981476459
DELHI_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/1jsyvxM-Ux8zQAyCgboDTwbFFT4tiufUFC4aNtYn2_n0/export?format=csv&gid=981476459

# Parallel Web Extract — scrape supplier event pages in one batch
# https://docs.parallel.ai/extract/quickstart
# Dashboard: https://platform.parallel.ai
PARALLEL_API_KEY=
